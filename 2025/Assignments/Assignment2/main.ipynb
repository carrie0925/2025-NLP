        "df_train['char_id_list'] = df_train['src'].apply(lambda x: [char_to_id[c] for c in x])\n",
        "df_train['label_id_list'] = df_train['tgt'].apply(lambda x: [char_to_id[c] for c in x] + [char_to_id['<eos>']])\n",
        "\n",
        "df_eval['char_id_list'] = df_eval['src'].apply(lambda x: [char_to_id[c] for c in x])\n",
